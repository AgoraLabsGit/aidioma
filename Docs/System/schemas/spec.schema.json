{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec.schema.json",
  "title": "Spec",
  "type": "object",
  "required": ["id", "kind", "title", "status", "decisions", "built_by", "research", "paths"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^SPEC-[FA]-[A-Z0-9-]+$" },
    "kind": { "enum": ["feature", "area"] },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "superseded", "contested"] },
    "superseded_by": { "type": ["string", "null"], "pattern": "^SPEC-[FA]-[A-Z0-9-]+$" },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^SPEC-A-[A-Z0-9-]+$" } },
    "vendor": { "type": ["string", "null"] },
    "decisions": { "type": "array", "items": { "type": "string", "pattern": "^D-[0-9]{3}$" } },
    "built_by": { "type": "array", "items": { "type": "string", "pattern": "^PHASE-[0-9]{3}$" } },
    "last_amended": { "type": ["string", "null"], "pattern": "^PHASE-[0-9]{3}$" },
    "research": { "type": "array", "items": { "type": "string", "pattern": "^R-[0-9]{3}$" } },
    "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "feature" } }, "required": ["kind"] },
      "then": { "required": ["depends_on"], "properties": { "vendor": { "const": null } } }
    },
    {
      "if": { "properties": { "kind": { "const": "area" } }, "required": ["kind"] },
      "then": { "not": { "required": ["depends_on"] } }
    },
    {
      "if": { "properties": { "status": { "const": "superseded" } }, "required": ["status"] },
      "then": { "properties": { "superseded_by": { "type": "string" } }, "required": ["superseded_by"] }
    }
  ]
}
