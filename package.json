{
  "name": "aidioma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "app:dev": "npm run dev --workspace @aidioma/web",
    "app:typecheck": "npm run typecheck --workspace @aidioma/web",
    "app:lint": "npm run lint --workspace @aidioma/web",
    "app:test": "npm run test --workspace @aidioma/web",
    "app:build": "npm run build --workspace @aidioma/web",
    "app:smoke": "npm run smoke --workspace @aidioma/web",
    "app:smoke:install": "npm run smoke:install --workspace @aidioma/web",
    "contract:build": "npm run build --workspace @aidioma/lesson-schema",
    "contract:typecheck": "npm run typecheck --workspace @aidioma/lesson-schema",
    "contract:smoke": "npm run smoke --workspace @aidioma/lesson-schema",
    "content:typecheck": "npm run contract:build --silent && tsc -p tooling/tsconfig.json --noEmit",
    "content:validate": "npm run contract:build --silent && tsx tooling/content/validate.ts content/lessons",
    "content:fixtures": "npm run contract:build --silent && tsx tooling/content/fixtures/run-fixtures.ts",
    "db:migrate": "node --env-file-if-exists=apps/web/.env.local --import tsx apps/web/scripts/db-migrate.ts",
    "content:seed": "npm run content:validate --silent && npm run db:migrate --silent && node --env-file-if-exists=apps/web/.env.local --import tsx apps/web/scripts/content-seed.ts",
    "prototype:export": "npm run contract:build --silent && tsx tooling/prototype/export-lessons.ts",
    "prototype:check": "npm run contract:build --silent && tsx tooling/prototype/export-lessons.ts --check",
    "practice:candidates": "npm run practice:candidates --workspace @aidioma/web --"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
