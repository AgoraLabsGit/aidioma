{
  "name": "@aidioma/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "contract:build": "npm run build --workspace @aidioma/lesson-schema",
    "prebuild": "npm run contract:build",
    "dev": "next dev",
    "start": "next start",
    "pretypecheck": "npm run contract:build",
    "typecheck": "next typegen && tsc --noEmit",
    "prelint": "npm run contract:build",
    "lint": "eslint . --max-warnings=0",
    "pretest": "npm run contract:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "next build",
    "prove:evaluate": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/prove-evaluate.ts",
    "references": "node scripts/capture-prototype-references.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:practice-sets": "node scripts/smoke-practice-sets-prototype.mjs",
    "smoke:install": "playwright install chromium"
  },
  "dependencies": {
    "@aidioma/lesson-schema": "*",
    "@ai-sdk/gateway": "4.0.31",
    "@clerk/nextjs": "^7.6.2",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/firewall": "1.2.2",
    "ai": "^7.0.41",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jest-axe": "^10.0.0",
    "jsdom": "^30.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
