# Clerk: both values are required to enable authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Neon Postgres: server-only. Operator migration/seed scripts have write access and default to
# the isolated Development identity; Preview must be explicit and Production needs a second opt-in.
DATABASE_URL=
AIDIOMA_DB_TARGET=development
# AIDIOMA_ALLOW_PRODUCTION_WRITES=
