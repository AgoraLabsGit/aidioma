# Clerk: both values are required to enable authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Neon Postgres: server-only. Operator migration/seed scripts have write access and default to
# the isolated Development identity; Preview must be explicit and Production needs a second opt-in.
DATABASE_URL=
AIDIOMA_DB_TARGET=development
# AIDIOMA_ALLOW_PRODUCTION_WRITES=

# AI Gateway: evaluations require this dedicated server-only credential so its own Gateway
# key budget governs every AI grading call. The same opaque ID is sent for reporting and quota
# lookup; per-user enforcement exists only when an account quota policy is configured and proven.
# Do not substitute ambient OIDC.
EVALUATION_AI_GATEWAY_API_KEY=
# The model setting is server-only and accepts only the two reviewed IDs.
EVALUATION_AI_MODEL=openai/gpt-5-mini

# Operator-only prototype Practice candidate generation. This credential has its own Gateway
# budget and never falls back to the evaluation key, ambient AI_GATEWAY_API_KEY, or Vercel OIDC.
PRACTICE_GENERATION_AI_GATEWAY_API_KEY=
PRACTICE_GENERATION_AI_MODEL=openai/gpt-5.6-terra
